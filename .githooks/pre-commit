#!/usr/bin/env python3
"""Read-only checks of the exact staged blobs, including an unborn branch."""
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


def git(*args):
    return subprocess.check_output(["git", *args])


def main():
    os.chdir(os.fsdecode(git("rev-parse", "--show-toplevel").strip()))
    if not shutil.which("gitleaks"):
        print("Commit stopped: Gitleaks must be in PATH. See CONTRIBUTING.md.", file=sys.stderr)
        return 1
    whitespace = subprocess.run(
        ["git", "diff", "--cached", "--check"], capture_output=True
    )
    if whitespace.returncode:
        print("Commit stopped: invalid whitespace or conflicts in the index. Run git diff --cached --check locally.", file=sys.stderr)
        return 1

    # A private export also works before the first commit; never follow symlinks.
    with tempfile.TemporaryDirectory(prefix="scale-staged-") as temporary:
        export = Path(temporary) / "files"
        export.mkdir(mode=0o700)
        for record in git("ls-files", "--stage", "-z").split(b"\0"):
            if not record:
                continue
            metadata, raw_path = record.split(b"\t", 1)
            mode, oid, stage = metadata.split()
            path = os.fsdecode(raw_path)
            if stage != b"0":
                print("Commit stopped: unresolved conflicts in the index.", file=sys.stderr)
                return 1
            if mode == b"160000":  # The submodule has its own repository.
                continue
            relative = Path(path)
            if relative.is_absolute() or ".." in relative.parts:
                print("Commit stopped: invalid path in the index.", file=sys.stderr)
                return 1
            data = git("cat-file", "blob", oid.decode("ascii"))
            if re.search(rb"^(?:<{7}|={7}|>{7})(?: |\r?$)", data, re.MULTILINE):
                print("Commit stopped: possible conflict markers in " + json.dumps(path), file=sys.stderr)
                return 1
            destination = export / relative
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.write_bytes(data)

        report = Path(temporary) / "report.json"
        result = subprocess.run(
            ["gitleaks", "dir", "--redact=100", "--no-banner", "--no-color",
             "--report-format", "json", "--report-path", str(report), str(export)],
            capture_output=True,
        )
        if result.returncode:
            if result.returncode == 1 and report.exists():
                findings = json.loads(report.read_text())
                for finding in findings:
                    filename = os.path.relpath(finding["File"], export)
                    print("Possible secret: " + json.dumps(filename) + " (" + finding["RuleID"] + ")", file=sys.stderr)
                print("Commit stopped: review the listed files; no sensitive values are printed.", file=sys.stderr)
            else:
                print("Commit stopped: Gitleaks execution error; scan incomplete.", file=sys.stderr)
            return 1
    print("Index verified: whitespace, conflicts and Gitleaks OK.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
